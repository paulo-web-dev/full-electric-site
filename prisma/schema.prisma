generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NOVO
  CONTATADO
  TEST_DRIVE_AGENDADO
  NEGOCIANDO
  VENDIDO
  PERDIDO
}

/// Por que o lead foi perdido — alimenta o relatório "perco por preço ou por estoque?"
enum MotivoPerda {
  PRECO
  OUTRA_LOJA
  SUMIU
  SEM_MODELO
  OUTRO
}

/// Como o cliente ficou sabendo da loja — só no cadastro manual e na ficha
/// (leads do site já trazem UTMs)
enum ComoConheceu {
  PANFLETO
  GOOGLE
  INSTAGRAM
  INDICACAO
  PASSOU_NA_FRENTE
  OUTRO
}

model Lead {
  id                 String        @id @default(cuid())
  nome               String
  telefone           String
  email              String?
  modeloInteresse    String
  uso                String
  horarioPreferido   String?
  /// Texto livre: o site grava a seção de origem (formulario, contato, entregadores);
  /// leads manuais usam as constantes ORIGENS_MANUAIS de lib/crm.ts.
  origem             String
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  status             LeadStatus    @default(NOVO)
  proximoContatoEm   DateTime?
  valorVenda         Decimal?      @db.Decimal(10, 2)
  dataVenda          DateTime?
  modeloVendido      String?
  motivoPerda        MotivoPerda?
  motivoPerdaDetalhe String?
  comoConheceu       ComoConheceu?
  /// Follow-up automático pelo agente do WhatsApp (/api/agent/followups):
  /// quantos já foram e quando foi o último. Máximo 3, intervalo de 24 h.
  followupCount      Int           @default(0)
  ultimoFollowup     DateTime?
  /// Pessoa pediu para não ser mais contatada. Só vira true (pela API ou
  /// pela equipe); nunca volta a false por máquina.
  optOut             Boolean       @default(false)
  /// Resumo gerado por IA a partir do histórico de ConversaAgente
  /// (scripts/enriquecer-leads.mjs). Dado derivado, reescrito a cada
  /// execução — por isso é coluna, não Nota (nota é histórico e não se
  /// sobrescreve).
  resumoAgente       String?
  /// Última análise do histórico pelo script (controla o reprocesso)
  resumoAtualizado   DateTime?
  criadoEm           DateTime      @default(now())
  atualizadoEm       DateTime      @updatedAt
  notas              Nota[]
  consentimentos     Consentimento[]

  @@index([status])
  @@index([criadoEm])
  @@index([proximoContatoEm])
  @@index([telefone])
}

model Nota {
  id       String   @id @default(cuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  texto    String
  criadoEm DateTime @default(now())

  @@index([leadId])
}

/// Histórico de consentimento LGPD: um registro por manifestação, nunca
/// sobrescrito — é o que se mostra se a pessoa questionar. Cai junto com o
/// lead (eliminação em cascata).
model Consentimento {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// formulario (checkbox do site) · verbal (balcão/telefone) ·
  /// whatsapp_automacao (/api/agent/leads) — rótulos em lib/crm.ts
  tipo         String
  /// Versão da política vigente na hora (POLITICA_VERSAO em lib/politica.ts,
  /// a data ISO); "anterior-a-2026-08-28" nos registros do backfill
  textoVersao  String
  registradoEm DateTime @default(now())
  /// De onde veio a manifestação: seção do site, campanha da automação, PRESENCIAL…
  origem       String
  /// Só quando a própria pessoa enviou (formulário): prova de quem consentiu
  ip           String?
  userAgent    String?

  @@index([leadId])
}

/// Estado da conversa do agente do WhatsApp (n8n): o histórico recente, para
/// o assistente não se apresentar de novo a cada mensagem, e a pausa quando
/// um humano assume pelo celular. Sem vínculo com Lead — a conversa existe
/// antes de haver consentimento de cadastro. Apagada após 90 dias sem
/// mensagem (/api/admin/expurgo).
model ConversaAgente {
  id           String    @id @default(cuid())
  /// Mesma máscara do Lead (formatarTelefone), para consultar pela mesma chave
  telefone     String    @unique
  /// Array de {role: "user"|"assistant", content: string} — no máximo 16 itens
  /// (poda em /api/agent/conversas)
  historico    Json      @default("[]")
  /// Agente pausado até este instante (humano assumiu). null = ativo
  pausadoAte   DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
}

/// Registro de cada execução do expurgo LGPD (/api/admin/expurgo) — prova de
/// que a retenção de 12 meses prometida na política está sendo cumprida.
model ExpurgoLog {
  id          String   @id @default(cuid())
  executadoEm DateTime @default(now())
  simulacao   Boolean
  limite      DateTime
  candidatos  Int
  apagados    Int
}
