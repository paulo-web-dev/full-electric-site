generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NOVO
  CONTATADO
  TEST_DRIVE_AGENDADO
  NEGOCIANDO
  VENDIDO
  PERDIDO
}

/// Por que o lead foi perdido — alimenta o relatório "perco por preço ou por estoque?"
enum MotivoPerda {
  PRECO
  OUTRA_LOJA
  SUMIU
  SEM_MODELO
  OUTRO
}

/// Como o cliente ficou sabendo da loja — só no cadastro manual e na ficha
/// (leads do site já trazem UTMs)
enum ComoConheceu {
  PANFLETO
  GOOGLE
  INSTAGRAM
  INDICACAO
  PASSOU_NA_FRENTE
  OUTRO
}

model Lead {
  id                 String        @id @default(cuid())
  nome               String
  telefone           String
  email              String?
  modeloInteresse    String
  uso                String
  horarioPreferido   String?
  /// Texto livre: o site grava a seção de origem (formulario, contato, entregadores);
  /// leads manuais usam as constantes ORIGENS_MANUAIS de lib/crm.ts.
  origem             String
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  status             LeadStatus    @default(NOVO)
  proximoContatoEm   DateTime?
  valorVenda         Decimal?      @db.Decimal(10, 2)
  dataVenda          DateTime?
  modeloVendido      String?
  motivoPerda        MotivoPerda?
  motivoPerdaDetalhe String?
  comoConheceu       ComoConheceu?
  criadoEm           DateTime      @default(now())
  atualizadoEm       DateTime      @updatedAt
  notas              Nota[]

  @@index([status])
  @@index([criadoEm])
  @@index([proximoContatoEm])
}

model Nota {
  id       String   @id @default(cuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  texto    String
  criadoEm DateTime @default(now())

  @@index([leadId])
}

/// Registro de cada execução do expurgo LGPD (/api/admin/expurgo) — prova de
/// que a retenção de 12 meses prometida na política está sendo cumprida.
model ExpurgoLog {
  id          String   @id @default(cuid())
  executadoEm DateTime @default(now())
  simulacao   Boolean
  limite      DateTime
  candidatos  Int
  apagados    Int
}
