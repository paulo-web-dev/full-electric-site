# Copie para .env e preencha. O docker-compose.yml lê este arquivo para o
# build (NEXT_PUBLIC_*) e para o runtime (todo o resto).

# ============================================================================
# ⚠️  VARIÁVEIS DE BUILD — NEXT_PUBLIC_*
# Entram no bundle do navegador durante o `next build`. Mudou uma delas?
# Precisa REBUILDAR a imagem (docker compose build). Só reiniciar não aplica.
# ============================================================================

# URL canonica do site em producao (sem barra final) — sitemap/robots/JSON-LD
NEXT_PUBLIC_SITE_URL=https://fulleletric.unysystens.com.br

# WhatsApp (somente digitos, com DDI e DDD) — confirmado pelo cliente em 24/08/2026.
# Hoje o número usado pelo site vem de content/site.json; esta variável é
# reservada e fica no build por consistência.
NEXT_PUBLIC_WHATSAPP=5541988881253

# Analytics (GA4 + Meta Pixel, sem GTM) — preencher quando tiver. ATENÇÃO: ao
# preencher, atualizar a Política de Privacidade (CLAUDE.md §3.7 e
# docs/PENDENCIAS.md).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ============================================================================
# VARIÁVEIS DE RUNTIME — lidas pelo servidor a cada requisição
# ============================================================================

# Banco de dados (Postgres)
# DATABASE_URL: usada em runtime. No Neon, a string COM pooler (*-pooler.*.neon.tech).
# DIRECT_URL: usada pelo `prisma migrate deploy` no entrypoint. No Neon, a
#             string SEM pooler. O banco fica no Neon — não roda no servidor.
DATABASE_URL=
DIRECT_URL=

# Admin (/admin) — os dois sao obrigatorios para o login funcionar
# ADMIN_PASSWORD: senha unica de acesso ao gerenciador de leads
# SESSION_SECRET: string aleatoria longa (32+ chars) que assina o cookie de sessao
#   gerar: openssl rand -base64 48
ADMIN_PASSWORD=
SESSION_SECRET=

# Quantos reverse proxies CONFIÁVEIS há na frente da app. Define de qual
# posição do X-Forwarded-For sai o IP do cliente (rate limit do formulário).
# Na VPS, atrás do Traefik existente = 1 (o Traefik entrega o IP do visitante
# como último item da lista; ele não acrescenta o próprio IP). Cloudflare na
# frente do Traefik, com trustedIPs configurado nele = 2. Ver docs/DEPLOY.md.
# Ausente: usa o primeiro IP da lista (comportamento antigo — forjável).
TRUST_PROXY_HOPS=1

# Notificacao de lead novo, opcional (o lead sempre e gravado no banco)
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_EMAIL_TO=
